<body>

<!-- ================= NAVBAR ================= -->
<nav class="navbar navbar-expand-md border-bottom sticky-top bg-white">
  <div class="container-fluid">

    <!-- Brand -->
    <a class="navbar-brand d-flex align-items-center" href="/listings" aria-label="Home">
      <i class="fa-brands fa-airbnb fs-3 text-danger"></i>
    </a>

    <!-- Mobile Toggle -->
    <button class="menu-btn d-md-none" id="menuToggle" aria-label="Menu">
      <i class="fa-solid fa-bars"></i>
    </button>

    <!-- ================= DESKTOP ================= -->
    <div class="d-none d-md-flex w-100 align-items-center">

      <a href="/listings" class="fw-semibold me-4 text-decoration-none text-dark">
        Explore
      </a>

      <!-- Search -->
      <div class="search-box position-relative">
        <input type="text" placeholder="Search destination" aria-label="Search">
        <i class="fa-solid fa-magnifying-glass"></i>
      </div>

      <!-- Right Section -->
      <div class="ms-auto d-flex align-items-center gap-4 fw-semibold">

        <a href="/listings/new" class="text-decoration-none text-dark">
          Airbnb your home <i class="fa-solid fa-globe ms-1"></i>
        </a>

        <% if(!currUser){ %>
          <a href="/signup" class="text-decoration-none text-dark">Signup</a>
          <a href="/login" class="text-decoration-none text-dark">Login</a>
        <% } else { %>
          <a href="/profile" class="d-flex align-items-center gap-2 text-decoration-none text-dark">
            <% if(currUser.profileImage){ %>
              <img src="<%= currUser.profileImage %>" class="rounded-circle"
                   style="width:32px;height:32px;object-fit:cover;">
            <% } else { %>
              <div class="default-avatar" data-name="<%= currUser.firstName %>">
                <%= currUser.firstName.charAt(0) %>
              </div>
            <% } %>
            Profile
          </a>
          <a href="/logout" class="text-decoration-none text-danger">Logout</a>
        <% } %>

      </div>
    </div>
  </div>
</nav>

<!-- ================= MOBILE MENU ================= -->
<div id="mobileMenu" class="mobile-menu">

  <a href="/listings/new"><i class="fa-solid fa-circle-plus"></i> Airbnb your home</a>
  <a href="/listings"><i class="fa-brands fa-airbnb"></i> Trips</a>
  <a href="#"><i class="fa-regular fa-message"></i> Messages</a>

  <% if(currUser){ %>
    <a href="/profile" class="d-flex align-items-center gap-2">
      <% if(currUser.profileImage){ %>
        <img src="<%= currUser.profileImage %>" class="rounded-circle"
             style="width:32px;height:32px;object-fit:cover;">
      <% } else { %>
        <div class="default-avatar" data-name="<%= currUser.firstName %>">
          <%= currUser.firstName.charAt(0) %>
        </div>
      <% } %>
      Profile
    </a>
  <% } %>

  <hr>

  <a href="#"><i class="fa-solid fa-gear"></i> Account settings</a>
  <a href="#"><i class="fa-solid fa-globe"></i> Language & Currency</a>
  <a href="#"><i class="fa-regular fa-circle-question"></i> Help Center</a>

  <hr>

  <% if(!currUser){ %>
    <a href="/signup">Signup</a>
    <a href="/login">Login</a>
  <% } else { %>
    <a href="/logout" class="text-danger">Logout</a>
  <% } %>
</div>

<!-- ================= JS ================= -->
<script>
/* Avatar color */
(() => {
  const colors = ["#0d6efd","#6f42c1","#198754","#fd7e14","#dc3545","#20c997","#6610f2"];
  document.querySelectorAll(".default-avatar").forEach(av => {
    const name = av.dataset.name || "U";
    let hash = 0;
    for (let c of name) hash = c.charCodeAt(0) + ((hash << 5) - hash);
    av.style.backgroundColor = colors[Math.abs(hash) % colors.length];
  });
})();

/* Mobile Menu */
const menu = document.getElementById("mobileMenu");
const toggle = document.getElementById("menuToggle");
const icon = toggle?.querySelector("i");

toggle?.addEventListener("click", () => {
  menu.classList.toggle("active");
  icon.classList.toggle("fa-bars");
  icon.classList.toggle("fa-xmark");
});
</script>

</body>
